# =============================================================================
# config.env.example — copy it to config.env and adjust:   cp config.env.example config.env
# Every setting of the agent lives here (nothing is hardcoded). config.env is gitignored.
# =============================================================================

# --- Model server (vllm-mlx, OpenAI + Anthropic compatible, loopback only) ---
# The agent talks to this server. Server-side options (tool-call parser, sampling, cache, chat-template
# kwargs) are flags of `vllm-mlx serve` itself; see the Quick start in the README.
MLX_MODEL="mlx-community/Qwen2.5-Coder-14B-Instruct-4bit"
SERVED_MODEL_NAME="qwen-coder"
SERVER_HOST="127.0.0.1"             # loopback only
SERVER_PORT="8000"

# --- Executor (empty = the local server above) ---
AGENT_BASE_URL=""
AGENT_MODEL=""
AGENT_API_KEY=""

# --- Optional STRONG brain for planner/verifier (FREE models only; empty = 100% local) ---
STRONG_BASE_URL=""                  # e.g. https://openrouter.ai/api/v1
STRONG_MODEL=""                     # must be a free model (e.g. ending in ':free')
STRONG_API_KEY=""                   # never commit a key

# --- Orchestration ---
MAX_VERIFY_ATTEMPTS="3"
PROJECT_MEMORY="true"
SELF_CRITIQUE="true"
LEARN_FROM_ERRORS="true"
METACOGNITION="true"
AGENT_PROJECTS_DIR="~/agent_projects"
CONV_LAST_N="6"                     # recent messages injected verbatim (light context)

# --- Web UI (loopback only) ---
WEB_HOST="127.0.0.1"
WEB_PORT="8080"
WEB_ALLOWED_HOSTS=""                # extra host names allowed to reach the UI (comma separated). Empty = local only
WEB_ALLOWED_PORTS=""                # extra ports allowed in the Origin (comma separated, e.g. an SSH tunnel). Empty = WEB_PORT only
UPLOAD_MAX_MB="20"

# --- Voice (100% local) ---
WHISPER_MODEL="mlx-community/whisper-tiny"
STT_INTERVAL_SEC="3"
STT_WINDOW_SEC="30"
STT_MAX_MB="25"

# --- Skills ---
SKILLS="true"
SKILLS_DIR="skills"
SKILL_THRESHOLD="0.30"              # minimum TF-IDF cosine to trigger a skill (higher = stricter)
SKILL_MAX_CHARS="4000"

# --- Retrieval (RAG) ---
EMBEDDINGS="0"                      # "1" turns on the optional hybrid semantic retrieval
EMBEDDINGS_MODEL=""                 # empty = mlx-community/multilingual-e5-small-mlx

# --- On-demand vision (separate process, frees its RAM when done) ---
VISION_MODEL="mlx-community/gemma-4-12b-it-4bit"   # empty = vision off
VISION_MAX_TOKENS="300"
VISION_MIN_FREE_GB="9"              # below this, the RAM hand-off kicks in (only if the brain can be restarted)
VISION_TIMEOUT_SEC="300"
VISION_AUTO_HANDOFF="1"
VISION_CONTEXT="1"                  # pass the chat's light context to the vision model
VISION_CONTEXT_MAX_CHARS="1200"

# --- Worker (agentic mode) ---
WORKER_MAX_STEPS="4"
WORKER_MAX_SEC="900"
WORKER_TEST_MAX_SEC="60"
WORKER_CONTRACT_FIRST="1"           # re-read the real module interface before writing its test
WORKER_STAGES="1"                   # staged runs with human approval between stages
WORKER_MAX_STAGES="8"
WORKER_APPROVAL_MAX_SEC="3600"

# --- Web search (free: arXiv + DuckDuckGo). OFF in this template so the default is fully offline.
# Set to "1" to let the agent search the web. Web content is always treated as untrusted DATA.
WEB_SEARCH="0"
