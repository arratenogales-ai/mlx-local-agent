# Isolated environment (recreated by `uv sync`)
.venv/

# Logs and temp files
*.log
__pycache__/
*.pyc
.DS_Store
**/.DS_Store

# E2E test folders
e2e_test/
e2e_tests/

# Local config: may contain your STRONG_API_KEY, so do NOT commit it to git.
# The tracked template is config.env.example.
config.env

# Project/knowledge data: NEVER commit, even if AGENT_PROJECTS_DIR sits inside the repo.
.trash/
**/.trash/
.knowledge/
**/.knowledge/
.snapshots/
**/.snapshots/
.memory.md
.lessons.md
.conversation_summary.md
conversation.jsonl
.active_project

# Self-audit report (regenerable by running the self-audit)
self_audit_report.md

# Anti personal-data safety net: never let a CV/PDF or project data get committed by accident.
*.pdf
CV_*
agent_projects/
**/agent_projects/


# Redesign review screenshots; do not version.
.preview/
.ruff_cache/
.pytest_cache/
